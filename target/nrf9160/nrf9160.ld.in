/* Linker script for bootloader memory regions. */
/* Generated from nrf9160.ld.in by CMake. */

FLASH_START_BL      = 0x0;
FLASH_SIZE_BL       = @BL_FLASH_SIZE@;

RAM_START           = 0x20000000;
RAM_SIZE            = 0x40000;

/* Bootloader uses the full RAM during execution.
   It hands off to riot-tee which reconfigures SPU regions. */
RAM_START_BL        = RAM_START;
RAM_SIZE_BL         = RAM_SIZE;