/*
 * Boot-time evaluation of riot-tee-bl (branch eval/boot-markers only).
 *
 * The stage pin toggles after every step of the start-up, so that an
 * oscilloscope shows the duration of each step. The pin is secure until
 * main() hands GPIO P0 to the non-secure world; from then on the secure
 * alias no longer reaches it and the non-secure alias is used.
 */
#ifndef TEE_TIMING_H
#define TEE_TIMING_H

#include "nrf9160.h"

#define TEE_TIMING_STAGE_PIN 10    /* the phase pin of BL1 */

static inline void tee_timing_mark(void)
{
    if (NRF_SPU_S->GPIOPORT[0].PERM & (1u << TEE_TIMING_STAGE_PIN)) {
        NRF_P0_S->OUT ^= 1u << TEE_TIMING_STAGE_PIN;
    }
    else {
        NRF_P0_NS->OUT ^= 1u << TEE_TIMING_STAGE_PIN;
    }
}

#endif /* TEE_TIMING_H */
